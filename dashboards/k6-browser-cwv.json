        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT percentile(\"value\",75) AS \"FCP\" FROM \"browser_web_vital_fcp\" WHERE $timeFilter GROUP BY \"name\"",
