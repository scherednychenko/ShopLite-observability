          "query": "SELECT percentile(\"value\",75) AS \"CLS\" FROM \"browser_web_vital_cls\" WHERE $timeFilter GROUP BY \"name\"",
          "rawQuery": true,
          "refId": "C",
          "resultFormat": "table"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT percentile(\"value\",75) AS \"TTFB\" FROM \"browser_web_vital_ttfb\" WHERE $timeFilter GROUP BY \"name\"",
          "rawQuery": true,
          "refId": "D",
          "resultFormat": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "indexByName": {
              "name": 0,
              "LCP": 1,
              "FCP": 2,
              "CLS": 3,
              "TTFB": 4
            },
            "renameByName": {
              "name": "Page"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
