{
  "uid": "shoplite-business-ops",
  "title": "ShopLite — Business Operations",
  "tags": [
    "shoplite",
    "k6",
    "business",
    "checks"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "",
  "templating": {
    "list": [
      {
        "name": "data_source",
        "type": "datasource",
        "query": "influxdb",
        "refresh": 1,
        "current": {
          "text": "InfluxDB-k6",
          "value": "shoplite-influxdb-k6"
        },
        "regex": "",
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Business operations — p95 duration (SLO < 3s) & success checks",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Login · p95",
      "datasource": {
        "type": "influxdb",
        "uid": "$data_source"
      },
      "description": "Time from submitting credentials to the app being stable, p95. SLO < 3s.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "decimals": 0,
          "min": 0,
          "max": 5000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "#EAB839",
                "value": 2000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT percentile(\"value\", 95) FROM \"op_login_ms\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Account Search · p95",
      "datasource": {
        "type": "influxdb",
        "uid": "$data_source"
      },
      "description": "Time from issuing a query to the account/result opening, p95. SLO < 3s.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "decimals": 0,
          "min": 0,
          "max": 5000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "#EAB839",
                "value": 2000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT percentile(\"value\", 95) FROM \"op_account_search_ms\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Operation success (checks pass-rate)",
      "datasource": {
        "type": "influxdb",
        "uid": "$data_source"
      },
      "description": "Share of operations that succeeded — the k6 'checks' metric, the same that sits next to Thresholds in k6 Cloud.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "#EAB839",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT mean(\"value\") FROM \"checks\" WHERE \"check\" =~ /^(Login|Account search)/ AND $timeFilter GROUP BY \"check\"",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series",
          "alias": "$tag_check"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^([^:]+):.*",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "row",
      "title": "Over the run",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Operation duration over the run (ms)",
      "datasource": {
        "type": "influxdb",
        "uid": "$data_source"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT \"value\" FROM \"op_login_ms\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series",
          "alias": "Login"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT \"value\" FROM \"op_account_search_ms\" WHERE $timeFilter",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series",
          "alias": "Account Search"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 6,
            "lineInterpolation": "smooth",
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}