    {
      "id": 30,
      "type": "table",
      "title": "Core Web Vitals by page (p75)",
      "datasource": {
        "type": "influxdb",
        "uid": "$data_source"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT percentile(\"value\",75) AS \"LCP\" FROM \"faro_web_vital_lcp\" WHERE $timeFilter GROUP BY \"page\"",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "table"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT percentile(\"value\",75) AS \"FCP\" FROM \"faro_web_vital_fcp\" WHERE $timeFilter GROUP BY \"page\"",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "table"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "$data_source"
          },
          "query": "SELECT percentile(\"value\",75) AS \"TTFB\" FROM \"faro_web_vital_ttfb\" WHERE $timeFilter GROUP BY \"page\"",
          "rawQuery": true,
          "refId": "C",
          "resultFormat": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "page",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "indexByName": {
              "page": 0,
              "LCP": 1,
              "FCP": 2,
              "TTFB": 3
            },
            "renameByName": {
              "page": "Page"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/LCP|FCP|TTFB/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
